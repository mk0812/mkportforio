{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "vue"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "node_modules"]
}